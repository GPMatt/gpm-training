# Copy this file to .env and fill in the real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# This .env is for local/CLI tooling only (e.g. running schema.sql, seeding
# data). It is NOT read by Google Apps Script or the PWA — see the note in
# chat about where those two need their own copies of these same values.

# Project Settings -> API -> Project URL
SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon / public
# Safe to expose in client-side code (the PWA). Access is controlled by
# Row Level Security policies, not by keeping this key secret.
SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role
# NEVER put this in the PWA or anywhere client-side. Server-side only
# (Apps Script, local scripts). Bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI
# Only needed if running schema.sql via psql/CLI instead of the SQL Editor.
SUPABASE_DB_URL=
